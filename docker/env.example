# TrendRadar Docker 环境变量配置模板
# 
# 使用方法：
# 1. 复制此文件为 .env：cp env.example .env
# 2. 根据需要修改配置
# 3. 启动容器：docker compose up -d
#
# 注意：敏感信息（如 webhook URLs、密码等）请妥善保管，不要提交到版本控制系统

# ============================================
# 核心配置
# ============================================

# 是否启用爬虫（true/false）
# 如果设为 false，程序将直接停止
ENABLE_CRAWLER=

# 是否启用通知功能（true/false）
# 如果设为 false，则不发送任何通知
ENABLE_NOTIFICATION=

# 报告模式：daily（当日汇总）/ incremental（增量监控）/ current（当前榜单）
REPORT_MODE=

# 排序优先级：true=先按配置位置排序，false=先按热点条数排序
SORT_BY_POSITION_FIRST=

# 每个关键词最大显示数量，0=不限制
MAX_NEWS_PER_KEYWORD=

# 内容顺序：false=热点词汇统计在前，true=新增热点新闻在前
REVERSE_CONTENT_ORDER=

# ============================================
# Web 服务器配置
# ============================================

# 是否自动启动 Web 服务器（true/false）
ENABLE_WEBSERVER=false

# Web 服务器端口（默认 8080）
WEBSERVER_PORT=8080

# ============================================
# 多账号配置
# ============================================

# 每个渠道最大账号数量，建议不超过 3
MAX_ACCOUNTS_PER_CHANNEL=

# ============================================
# 推送时间窗口配置
# ============================================

# 是否启用推送时间窗口控制（true/false）
PUSH_WINDOW_ENABLED=

# 推送时间窗口开始时间（格式：HH:MM，如 08:00）
PUSH_WINDOW_START=

# 推送时间窗口结束时间（格式：HH:MM，如 22:00）
PUSH_WINDOW_END=

# 每天在时间窗口内只推送一次（true/false）
# 如果 false，则窗口内每次执行都推送
PUSH_WINDOW_ONCE_PER_DAY=

# ============================================
# 通知渠道配置
# ============================================

# 飞书机器人 Webhook URL（多账号用 ; 分隔）
# 示例：https://open.feishu.cn/open-apis/bot/v2/hook/xxx
FEISHU_WEBHOOK_URL=

# 钉钉机器人 Webhook URL（多账号用 ; 分隔）
# 示例：https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_WEBHOOK_URL=

# 企业微信机器人 Webhook URL（多账号用 ; 分隔）
# 示例：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
WEWORK_WEBHOOK_URL=

# 企业微信消息类型：markdown（群机器人）或 text（个人微信应用）
WEWORK_MSG_TYPE=markdown

# Telegram Bot Token（多账号用 ; 分隔，需与 chat_id 数量一致）
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID（多账号用 ; 分隔，需与 bot_token 数量一致）
TELEGRAM_CHAT_ID=

# 邮件配置
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=

# ntfy 配置
# 服务器地址，默认使用公共服务，可改为自托管地址
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Bark 推送 URL（多账号用 ; 分隔）
# 格式：https://api.day.app/your_device_key 或自建服务器地址
BARK_URL=

# Slack Incoming Webhook URL（多账号用 ; 分隔）
# 格式：https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=

# ============================================
# 存储配置
# ============================================

# 存储后端选择：local / remote / auto
# - local: 本地 SQLite + TXT/HTML 文件
# - remote: 远程云存储（S3 兼容协议）
# - auto: 自动选择（GitHub Actions 环境且配置了远程存储则用 remote，否则用 local）
STORAGE_BACKEND=auto

# 本地数据保留天数（0 = 不清理）
LOCAL_RETENTION_DAYS=0

# 远程数据保留天数（0 = 不清理）
REMOTE_RETENTION_DAYS=0

# 是否生成 TXT 快照（true/false）
STORAGE_TXT_ENABLED=true

# 是否生成 HTML 报告（true/false）
# ⚠️ 邮件推送必须设为 true，否则会报错
STORAGE_HTML_ENABLED=true

# ============================================
# 远程存储配置（S3 兼容协议）
# ============================================
# 支持：Cloudflare R2, 阿里云 OSS, 腾讯云 COS, AWS S3, MinIO 等
#
# Cloudflare R2 示例：
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET_NAME=your-bucket-name
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_REGION=auto
#
# 阿里云 OSS 示例：
# S3_ENDPOINT_URL=https://oss-cn-hangzhou.aliyuncs.com
# S3_BUCKET_NAME=your-bucket-name
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_REGION=cn-hangzhou

S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# ============================================
# 数据拉取配置
# ============================================
# 用于 MCP Server 等场景：爬虫存到远程，MCP 拉取到本地分析

# 是否启用启动时自动拉取（true/false）
PULL_ENABLED=false

# 拉取最近 N 天的数据（0 = 不拉取）
PULL_DAYS=7

# ============================================
# 运行模式配置
# ============================================

# Cron 表达式（默认每30分钟执行一次）
# 示例：
#   */30 * * * *  - 每30分钟
#   0 * * * *     - 每小时
#   0 9 * * *     - 每天9点
#   0 9 * * 1-5   - 工作日9点
CRON_SCHEDULE=*/30 * * * *

# 运行模式：cron（定时执行）/ once（单次执行）
RUN_MODE=cron

# 启动时是否立即执行一次（true/false）
IMMEDIATE_RUN=true

# ============================================
# 时区配置
# ============================================
# 默认使用 Asia/Shanghai（北京时间 UTC+8）
TZ=Asia/Shanghai

